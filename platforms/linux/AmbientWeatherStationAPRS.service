[Unit]
Description=Ambient Weather Station APRS Reporter

[Service]
User=
WorkingDirectory=
Type=simple
Restart=always
SuccessExitStatus=143
RemainAfterExit=yes
Environment=AW_HTTP_PORT=8888
Environment=AW_CALLSIGN=xxxxxx
Environment=AW_LAT=xxxxxx
Environment=AW_LON=xxxxxx

ExecStart=java -jar ambientweatheragent-1.3.jar

[Install]
WantedBy=multi-user.target

